// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

//Har ikke funnet en måte prisma kan importere fra types.ts, må manuellt passe på at disse stemmer overens
enum ReservationState {
    PENDING
    APPROVED 
    REJECTED 
}

model BookableItem {
    itemId          Int       @id @default(autoincrement())
    name            String
    description     String
    allowsAlcohol   Boolean
    groupSlug       String
    imageUrl        String?
    reservations    Reservation[]
    FAQs            FAQ[] 
    @@index([name])
}


model Reservation {
    reservationId              Int @id @default(autoincrement())
    authorId        String
    bookableItem    BookableItem @relation(fields: [bookableItemId], references: [itemId])
    bookableItemId  Int
    startTime       DateTime
    endTime         DateTime
    status          ReservationState @default(PENDING)
    description     String
    acceptedRules   Boolean
    groupSlug       String
    servesAlcohol   Boolean
    soberWatch      String?
    approvedById    String?
}

/**
 * Photon-tokenene som hører til en innlogget økt.
 *
 * De kunne ligget i JWT-en sammen med resten av økta, men Photon roterer
 * refresh-tokens og regner andre gangs bruk som tyveri — hele kjeden slettes og
 * brukeren kastes ut. To forespørsler som kommer samtidig bærer med seg den
 * samme informasjonskapselen, altså det samme refresh-tokenet, så det ville
 * skjedd omtrent hver time når tokenet utløper. Her ligger de ett sted, og en
 * fornyelse er synlig for alle forespørsler med én gang.
 *
 * JWT-en inneholder bare `id` herfra. Access-tokenet nås aldri av nettleseren.
 */
model PhotonSession {
    id           String   @id @default(uuid())
    /// Photons bruker-id (`sub`), som profiloppslag gjøres med.
    subject      String
    accessToken  String
    refreshToken String?
    /// Når access-tokenet utløper.
    expiresAt    DateTime
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@index([updatedAt])
}

model FAQ {
    questionId      Int @id @default(autoincrement())
    question        String
    answer          String
    groupSlug       String?
    author          String
    bookableItems   BookableItem[]
    imageUrl        String
}
